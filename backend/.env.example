# Server env vars. Copy to backend/.env for local dev; on Vercel set them in the project settings.

# NASA FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/area/). Required: /api/fires fails without it.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Port for local dev (Vercel ignores it). Default 8787; the Vite dev server proxies /api to it.
PORT=8787
