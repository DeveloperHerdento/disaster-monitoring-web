# Client env vars (Vite exposes only VITE_* to the browser, so never put secrets here).
# Copy to frontend/.env for local dev; on Vercel set them in the project settings.

# Windy Map Forecast API key for the wind/forecast layer (src/lib/windyApi.ts). Optional: without it the Windy panel shows a "set key" message.
VITE_WINDY_MAP_FORECAST_KEY=
