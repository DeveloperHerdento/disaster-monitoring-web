# Docker only: copy to .env next to docker-compose.yml. Local dev without Docker uses backend/.env and frontend/.env.

# Compose project name, image to run and host port (bound to 127.0.0.1)
COMPOSE_PROJECT_NAME=fire-monitoring-web-staging
IMAGE=fire-monitoring-web:local
PORT=8787

# NASA FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/area/). Required: /api/fires fails without it.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# VITE_WINDY_MAP_FORECAST_KEY is NOT read here: it is a build-time value, pass it to
# `docker build --build-arg VITE_WINDY_MAP_FORECAST_KEY=...` (it ends up in the public JS bundle).
